<apex:page standardController="Contract" extensions="SaveContract" action="{!CreateContract}" showHeader="false" sidebar="false" renderAs="pdf" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="xhtml-1.0">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style type="text/css">
    /* ── identical reset + @page rules as Quote VF ── */
    * {
        margin: 0; padding: 0;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 8.5pt;
        color: #1a1a1a;
    }
    @page {
        size: A4;
        margin-top: 230px;
        margin-bottom: 140px;
        margin-left: 60px;
        margin-right: 60px;

        @top-left {
            content: element(page-header);
        }

        @bottom-left {
            content: element(page-footer);
        }
    }
    body { margin-right: 0; margin-left: 0; }

    /* HEADER */
    #header            { position: running(page-header); }
    #header-inner      { width: 100%; padding-bottom: 6px; margin-bottom: 4px; }
    .header-banner     { width: 100%; display: block; }

    /* FOOTER */
    #footer            { position: running(page-footer); padding-top: 0; width: 674.5px; }
    .footer-topline    { border-top: 1px solid #5f5f5f; width: 674.5px; margin-bottom: 10px; }
    .footer-grid       { width: 674.5px; border-collapse: collapse; }
    .footer-grid td    { padding: 0; vertical-align: top; font-size: 7.6pt; line-height: 1.35; }
    .footer-page       { margin-top: 14px; text-align: right; font-size: 8pt; }
    .pagenumber:before { content: counter(page); }
    .pagecount:before  { content: counter(pages); }

    /* RECIPIENT */
    .recipient-table    { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
    .recipient-table td { padding: 0; vertical-align: top; font-size: 8.5pt; line-height: 1.65; }
    .recipient-left     { width: 55%; font-weight: bold; }
    .recipient-right    { width: 45%; }

    /* TERMS */
    .terms-table    { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
    .terms-table td { padding: 2px 0; vertical-align: top; font-size: 8.3pt; line-height: 1.55; }
    .terms-value    { width: 100%; text-align: justify; }

    /* ITEMS TABLE */
    .items-table        { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    .items-total-table  { width: 100%; border-collapse: collapse; margin-top: 0; page-break-inside: avoid; }
    .items-table th     { background: transparent; color: #111; border: 0;
                          border-bottom: 1px solid #1f1f1f; padding: 0 0 4px 0;
                          font-size: 8.3pt; text-align: left; font-weight: bold; }
    .items-table th.r   { text-align: right; }
    .items-table th.c   { text-align: center; }
    .items-table td     { border: 0; padding: 4px 0; vertical-align: top; font-size: 8.3pt; }
    .items-total-table td { border: 0; padding: 7px 0; vertical-align: top; font-size: 8.3pt; }
    .items-table td.r   { text-align: right; }
    .items-table td.c   { text-align: center; }
    .items-total-table td.r { text-align: right; }
    .section-hdr td     { font-weight: bold; font-size: 8.3pt; color: #111;
                          border: 0; padding: 3px 0 5px 0; }
    .main-item-row td   { font-weight: bold; }
    .total-hdr td       { font-weight: bold;
                          border-top: 1px solid #1f1f1f;
                          border-bottom: 1px solid #1f1f1f;
                          padding: 7px 0; }
    .total-hdr          { page-break-inside: avoid; page-break-after: avoid; }
    .total-label        { text-align: center; }
    .total-amt          { text-align: right; }
    .opt-head           { font-weight: bold; font-style: italic; margin-top: 6px;
                          margin-bottom: 4px; font-size: 8.3pt; color: #4f4f4f; }
    .opt-item           { font-size: 8.3pt; font-style: italic; color: #5a5a5a;
                          line-height: 1.55; font-weight: normal; }
    .price-in-words     { page-break-inside: avoid; margin-top: 8px;
                          font-size: 8.3pt; line-height: 1.5; padding-top: 7px; }
    .text-after-total   { page-break-inside: avoid; margin-top: 8px;
                          font-size: 8.3pt; line-height: 1.5; }

    /* PAGE BREAK */
    .pgbreak { page-break-before: always; }

    /* CONDITIONS / PROVISIONS */
    .conditions-heading  { font-size: 11pt; font-weight: bold; color: #000;
                           border: 0; padding-bottom: 0; margin-bottom: 2px; line-height: 1.15; }
    .provisions-heading  { font-size: 9pt; font-weight: bold; color: #000;
                           text-align: center; border: 0; padding: 0;
                           margin: 28px 0 12px 0; line-height: 1.15; }
    .clause-body         { font-size: 8.2pt; line-height: 1.55; text-align: justify; margin-bottom: 3px; }
    .preamble            { font-size: 8.2pt; line-height: 1.55; text-align: justify; margin-bottom: 12px; }

    /* SIGNATURE */
    .signature-section  { margin-top: 72px; width: 100%;
                          table-layout: fixed; border-collapse: collapse; }
    .signature-section td { width: 50%; vertical-align: top; text-align: center; }
    .signature-line     { width: 78%; margin: 0 auto 6px auto;
                          border-top: 1px solid #000; height: 1px; }
    .signature-role,
    .signature-name,
    .signature-title    { font-size: 8.5pt; font-weight: bold; line-height: 1.35; color: #000; }
</style>
</head>
<body>

    <!-- ═══════════════════════════════════════════════════════════════════
         RUNNING HEADER
    ════════════════════════════════════════════════════════════════════ -->
    <div id="header" style="width: 674.5px;">
        <div id="header-inner">
            <!-- Released contract → full header image; Draft → watermark image -->
            <apex:outputPanel rendered="{!showSaveContract}">
                <apex:image value="{!contractTemplate.Header_Image__c}"
                            styleClass="header-banner"/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(showSaveContract)}">
                <apex:image value="{!contractTemplate.Draft_Image__c}"
                            style="width:200px;height:90px;position:relative;"/>
            </apex:outputPanel>
        </div>
        <br/>
        <div style="font-size:15px; line-height:1;">
            <span style="color:#000000;">No:</span>
            <span style="color:#656565;">&nbsp;&nbsp;&nbsp;{!ContractNumber}</span><br/>
            <span style="color:#000000;">Date:</span>
            <span style="color:#656565;">&nbsp;&nbsp;&nbsp;{!IF(NOT(ISBLANK(TodayDate_string)), TodayDate_string, TEXT(ObjQuote.DATE__c))}</span>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════
         RUNNING FOOTER  (static — Nissei ASB GmbH)
    ════════════════════════════════════════════════════════════════════ -->
    <div id="footer">
        <div class="footer-topline"></div>
        <table class="footer-grid">
            <tr>
                <td style="width:100px; padding-right:57px;">
                    Nissei ASB GmbH<br/>
                    Wahlerstr. 8<br/>
                    40472 D&#252;sseldorf<br/>
                    Germany
                </td>
                <td style="width:100px; padding-right:57px;">
                    Gesch&#228;ftsf&#252;hrung:<br/>
                    Karel Keersmaekers-Michiels<br/>
                    Kota Aoki<br/>
                    Eva Alzas Guillen
                </td>
                <td style="width:100px; padding-right:57px;">
                    Sitz der Gesellschaft:<br/>
                    Amtsgericht D&#252;sseldorf<br/>
                    HRB 22191
                </td>
                <td style="width:100px;">
                    St.-Nr.: 105/5832/0456<br/>
                    VAT-No.: DE119353439<br/>
                    Tel.:+49 (211) 941040<br/>
                    www.nisseiasb.co.jp
                </td>
            </tr>
        </table>
        <div class="footer-page">
            Page <span class="pagenumber"></span> of <span class="pagecount"></span>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════
         PAGE BODY — RECIPIENT
    ════════════════════════════════════════════════════════════════════ -->
    <table class="recipient-table">
        <tr>
            <td class="recipient-left">
                <!-- "Delivery To:" label — mirrors Quote's "To:" convention -->
                <div style="font-weight:normal; font-size:9.2pt; padding-left: 450px;">Delivery&#160;To:</div>

                <!-- Priority: QUOTATION_ADDRESSED_TO lookup → QuoteToName → Legal Name -->
                <apex:outputPanel rendered="{!NOT(ISBLANK(ObjQuote.QUOTATION_ADDRESSED_TO__c))}">
                    <div>{!ObjQuote.QUOTATION_ADDRESSED_TO__r.Name}</div>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!AND(ISBLANK(ObjQuote.QUOTATION_ADDRESSED_TO__c),
                                                  NOT(ISBLANK(ObjAccount.Legal_Name__c)))}">
                    <div>{!ObjAccount.Legal_Name__c}</div>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!AND(ISBLANK(ObjQuote.QUOTATION_ADDRESSED_TO__c),
                                                  ISBLANK(ObjAccount.Legal_Name__c))}">
                    <div>{!ObjAccount.Name}</div>
                </apex:outputPanel>

                <!-- Address block: custom fields first, fallback message -->
                <apex:outputPanel rendered="{!NOT(ISBLANK(address))}">
                    <div><apex:outputText escape="false" value="{!address}"/></div>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!ISBLANK(address)}">
                    <div>(Recipient address not mapped)</div>
                </apex:outputPanel>
            </td>
            <td class="recipient-right"></td>
        </tr>
    </table>

    <!-- ═══════════════════════════════════════════════════════════════════
         TERMS / INTRO TEXT  (from Contract_Template_Line__c)
    ════════════════════════════════════════════════════════════════════ -->
    <apex:outputPanel rendered="{!NOT(ISBLANK(contractTemplate.Id))}">
        <apex:outputPanel rendered="{!terms.size > 0}">
            <table class="terms-table">
                <tbody>
                    <apex:repeat value="{!terms}" var="cTerms">
                        <tr>
                            <td class="terms-value">
                                <apex:outputField value="{!cTerms.Content_2__c}"/>
                            </td>
                        </tr>
                    </apex:repeat>
                </tbody>
            </table>
        </apex:outputPanel>
    </apex:outputPanel>

    <!-- ═══════════════════════════════════════════════════════════════════
         LINE ITEMS TABLE
    ════════════════════════════════════════════════════════════════════ -->
    <table class="items-table">
        <thead>
            <tr>
                <th style="width:5%;">Pos.</th>
                <th style="width:54%;">Description</th>
                <th class="c" style="width:10%;">Quantity</th>
                <th class="r" style="width:16%;">
                    Unit Price {!ObjQuote.CurrencyIsoCode}
                </th>
                <th class="r" style="width:15%;">
                    Total {!ObjQuote.CurrencyIsoCode}
                </th>
            </tr>
        </thead>
        <tbody>
            <apex:repeat value="{!prodLineList}" var="cLine">
                <apex:outputPanel layout="none" rendered="{!NOT(cLine.Is_Tax)}">

                    <!-- Section header (Product_Type grouping) -->
                    <apex:outputPanel layout="none"
                                      rendered="{!NOT(ISBLANK(cLine.Product_Type))}">
                        <tr class="section-hdr">
                            <td colspan="5">{!cLine.Product_Type}</td>
                        </tr>
                    </apex:outputPanel>

                    <!-- Main item row -->
                    <tr class="main-item-row">
                        <td>{!cLine.Position_Number}</td>
                        <td>
                            <apex:outputPanel rendered="{!ISBLANK(cLine.Product_Description)}">
                                <strong>{!cLine.Product_Name}</strong>
                            </apex:outputPanel>
                            <apex:outputText rendered="{!NOT(ISBLANK(cLine.Product_Description))}"
                                            escape="false"
                                            value="{!cLine.Product_Description}"/>
                            <!-- Options header label -->
                            <apex:outputPanel rendered="{!NOT(ISBLANK(cLine.Option_Header))}">
                                <div class="opt-head">{!cLine.Option_Header}</div>
                            </apex:outputPanel>
                        </td>
                        <td class="c">{!cLine.Quantity}</td>
                        <td class="r">{!cLine.totalValueString}</td>
                        <td class="r">{!cLine.Ceiling_Total_Sales_Pricestring}</td>
                    </tr>

                    <!-- Child options -->
                    <apex:repeat value="{!cLine.childProd}" var="cOpt">
                        <apex:outputPanel layout="none"
                                          rendered="{!NOT(cOpt.Name_Hide)}">
                            <tr>
                                <td></td>
                                <td>
                                    <div class="opt-item">
                                        <apex:outputPanel
                                            rendered="{!NOT(ISBLANK(cOpt.Description))}">
                                            <apex:outputText escape="false"
                                                            value="{!cOpt.Description}"/>
                                        </apex:outputPanel>
                                        <apex:outputPanel
                                            rendered="{!ISBLANK(cOpt.Description)}">
                                            {!cOpt.Manual_Product_Name}
                                        </apex:outputPanel>
                                    </div>
                                </td>
                                <td class="c">
                                    <apex:outputPanel rendered="{!cOpt.Price_Visible}">
                                        {!IF(cOpt.Quantity != null, cOpt.Quantity, '')}
                                    </apex:outputPanel>
                                </td>
                                <td class="r">
                                    <apex:outputPanel rendered="{!cOpt.Price_Visible}">
                                        {!IF(cOpt.Manual_Option_List_Price != null,
                                             cOpt.Manual_Option_List_Price, '')}
                                    </apex:outputPanel>
                                </td>
                                <td class="r">
                                    <apex:outputPanel rendered="{!cOpt.Price_Visible}">
                                        {!IF(cOpt.Sales_Price != null,
                                             cOpt.Sales_Price, '')}
                                    </apex:outputPanel>
                                </td>
                            </tr>
                        </apex:outputPanel>
                    </apex:repeat>

                </apex:outputPanel>
            </apex:repeat>
        </tbody>
    </table>

    <!-- ═══════════════════════════════════════════════════════════════════
         GRAND TOTAL ROW
    ════════════════════════════════════════════════════════════════════ -->
    <table class="items-total-table">
        <tbody>
            <tr class="total-hdr">
                <td colspan="4" class="total-label">
                    <!-- Q_PrintShipping__c holds the label with incoterm text    -->
                    <!-- e.g. "CIF Port of ..., Total (CurrencyIsoCode):"         -->
                    <apex:outputPanel rendered="{!NOT(ISBLANK(ObjQuote.Q_PrintShipping__c))}">
                        <apex:outputText escape="false"
                                         value="{!ObjQuote.Q_PrintShipping__c}"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!ISBLANK(ObjQuote.Q_PrintShipping__c)}">
                        Total ({!ObjQuote.CurrencyIsoCode}) :
                    </apex:outputPanel>
                </td>
                <td class="total-amt">{!getWithoutTaxGrandValueString}</td>
            </tr>
        </tbody>
    </table>

    <!-- Price in words -->
    <apex:outputPanel rendered="{!ObjQuote.Price_in_Word_Required__c}">
        <div class="price-in-words">
            <apex:outputText value="{!IF(NOT(ISBLANK(contractTemplate.Label_for_Price_in_Word__c)),
                                        contractTemplate.Label_for_Price_in_Word__c,
                                        'Price In Words:')}"/>
            <apex:outputText value=" {!no2words}"/>
        </div>
    </apex:outputPanel>

    <!-- Free-text block after total (e.g. validity note, bank details) -->
    <apex:outputPanel rendered="{!NOT(ISBLANK(ObjQuote.Text_After_Total__c))}">
        <div class="text-after-total">
            <apex:outputText escape="false" value="{!ObjQuote.Text_After_Total__c}"/>
        </div>
    </apex:outputPanel>

    <!-- ═══════════════════════════════════════════════════════════════════
         GENERAL CONDITIONS  (Section 4 — from gRemark template lines)
    ════════════════════════════════════════════════════════════════════ -->
    <apex:outputPanel rendered="{!NOT(ISBLANK(contractTemplate.Id))}">
        <apex:outputPanel rendered="{!contractTemplate.Section_4_Required__c}">
            <div class="pgbreak">
                <div class="conditions-heading">
                    <apex:outputPanel
                        rendered="{!NOT(ISBLANK(contractTemplate.S4_Title__c))}">
                        <apex:outputText escape="false"
                                         value="{!contractTemplate.S4_Title__c}"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!ISBLANK(contractTemplate.S4_Title__c)}">
                        <u>GENERAL CONDITIONS</u>
                    </apex:outputPanel>
                </div>
                <apex:repeat value="{!gRemark}" var="remark">
                    <div class="clause-body">
                        <apex:outputField value="{!remark.Content_2__c}"/>
                    </div>
                </apex:repeat>
            </div>
        </apex:outputPanel>

        <!-- ═══════════════════════════════════════════════════════════════
             GENERAL PROVISIONS  (Section 5 — from gProvision template lines)
        ════════════════════════════════════════════════════════════════ -->
        <apex:outputPanel rendered="{!contractTemplate.Section_5_Required__c}">
            <div class="pgbreak">
                <div class="provisions-heading">
                    <apex:outputPanel
                        rendered="{!NOT(ISBLANK(contractTemplate.S5_Title__c))}">
                        <apex:outputText escape="false"
                                         value="{!contractTemplate.S5_Title__c}"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!ISBLANK(contractTemplate.S5_Title__c)}">
                        GENERAL PROVISIONS
                    </apex:outputPanel>
                </div>

                <!-- Preamble rendered first if it exists as first provision record -->
                <apex:repeat value="{!gProvision}" var="provision">
                    <div class="clause-body">
                        <apex:outputField value="{!provision.Content_2__c}"/>
                    </div>
                </apex:repeat>

                <!-- ── Signature block (dynamic) ─────────────────────── -->
                <table class="signature-section">
                    <tr>
                        <td>
                            <div class="signature-line"></div>
                            <div class="signature-role">Seller</div>
                            <!-- Subsidiary name from template; fallback to static -->
                            <div class="signature-name">
                                <apex:outputPanel
                                    rendered="{!NOT(ISBLANK(contractTemplate.Subsidiary__r.Name__c))}">
                                    {!contractTemplate.Subsidiary__r.Name__c}
                                </apex:outputPanel>
                                <apex:outputPanel
                                    rendered="{!ISBLANK(contractTemplate.Subsidiary__r.Name__c)}">
                                    Nissei ASB GmbH
                                </apex:outputPanel>
                            </div>
                            <div class="signature-name">{!ObjUser.Name}</div>
                            <div class="signature-title">{!ObjUser.Title}</div>
                        </td>
                        <td>
                            <div class="signature-line"></div>
                            <div class="signature-role">Buyer</div>
                            <div class="signature-name">
                                <apex:outputPanel
                                    rendered="{!NOT(ISBLANK(ObjAccount.Legal_Name__c))}">
                                    {!ObjAccount.Legal_Name__c}
                                </apex:outputPanel>
                                <apex:outputPanel
                                    rendered="{!ISBLANK(ObjAccount.Legal_Name__c)}">
                                    {!ObjAccount.Name}
                                </apex:outputPanel>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </apex:outputPanel>
    </apex:outputPanel>

</body>
</html>
</apex:page>
