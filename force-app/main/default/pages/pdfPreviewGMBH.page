<apex:page standardController="Quote" extensions="SaveQuoteAsPdf" action="{!CreateQuote}" showHeader="false" sidebar="false" renderAs="pdf" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="xhtml-1.0">
    <html xmlns="http://www.w3.org/1999/xhtml">
    <head>
    <style type="text/css">
            * {
                margin: 0;
                padding: 0;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 8.5pt;
                color: #1a1a1a;
            }

            @page {
                size: A4;
                margin-top: 230px;
                margin-bottom: 140px;
                margin-left: 60px;
                margin-right: 60px;

                @top-left {
                    content: element(page-header);
                }

                @bottom-left {
                    content: element(page-footer);
                }
            }

            body {
                margin-right: 0;
                margin-left: 0;
            }

            /* HEADER */
            #header {
                position: running(page-header);
            }

            #header-inner {
                width: 100%;
                padding-bottom: 6px;
                margin-bottom: 4px;
            }
            .header-banner {
                width: 100%;
                display: block;
            }

            .header-table {
                width: 100%;
                border-collapse: collapse;
            }
            .header-table td {
                padding: 0;
                vertical-align: top;
            }
            .header-left  { width: 55%; }
            .header-right { width: 45%; text-align: right; }

            .quotation-label {
                font-size: 22pt;
                font-weight: bold;
                color: #1a3a6b;
                line-height: 1;
            }

            .meta-table { border-collapse: collapse; margin-top: 5px; }
            .meta-table td { padding: 1px 8px 1px 0; font-size: 8pt; vertical-align: top; }
            .meta-label { color: #555555; }
            .meta-value { font-weight: bold; }

            .brand-name {
                font-size: 13pt;
                font-weight: bold;
                color: #1a3a6b;
            }
            .brand-asb {
                font-size: 26pt;
                font-weight: bold;
                color: #cc0000;
                line-height: 1;
            }

            /* FOOTER */
            #footer {
                position: running(page-footer);
                padding-top: 0;
                width: 674.5px;
            }
            .footer-topline {
                border-top: 1px solid #5f5f5f;
                width: 674.5px;
                margin-bottom: 10px;
            }
            .footer-grid {
                width: 674.5px;
                border-collapse: collapse;
            }
            .footer-grid td {
                padding: 0;
                vertical-align: top;
                font-size: 7.6pt;
                line-height: 1.35;
            }
            .footer-page {
                margin-top: 14px;
                text-align: right;
                font-size: 8pt;
            }
            .pagenumber:before {
                content: counter(page);
            }
            .pagecount:before {
                content: counter(pages);
            }

            /* RECIPIENT */
            .recipient-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 14px;
            }
            .recipient-table td { padding: 0; vertical-align: top; font-size: 8.5pt; line-height: 1.65; }
            .recipient-left  { width: 55%; font-weight: bold; }
            .recipient-right { width: 45%; }
            .recipient-name  { font-weight: bold; }
            .terms-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 14px;
            }
            .terms-table td {
                padding: 2px 0;
                vertical-align: top;
                font-size: 8.3pt;
                line-height: 1.55;
            }
            .terms-label {
                width: 25%;
                padding-right: 8px;
                font-weight: bold;
            }
            .terms-separator {
                width: 5%;
            }
            .terms-value {
                width: 70%;
                text-align: justify;
            }

            /* ITEMS TABLE */
            .items-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 8px;
            }
            .items-total-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 0;
                page-break-inside: avoid;
            }
            .items-table th {
                background: transparent;
                color: #111111;
                border: 0;
                border-bottom: 1px solid #1f1f1f;
                padding: 0 0 4px 0;
                font-size: 8.3pt;
                text-align: left;
                font-weight: bold;
            }
            .items-table th.r { text-align: right; }
            .items-table th.c { text-align: center; }

            .items-table td {
                border: 0;
                padding: 4px 0;
                vertical-align: top;
                font-size: 8.3pt;
            }
            .items-total-table td {
                border: 0;
                padding: 7px 0;
                vertical-align: top;
                font-size: 8.3pt;
            }
            .items-table td.r { text-align: right; }
            .items-table td.c { text-align: center; }
            .items-total-table td.r { text-align: right; }

            .section-hdr td {
                background: transparent;
                font-weight: bold;
                font-size: 8.3pt;
                color: #111111;
                border: 0;
                padding: 3px 0 5px 0;
            }
            .main-item-row td { font-weight: bold; }
            .total-hdr td {
                background: transparent;
                font-weight: bold;
                border-top: 1px solid #1f1f1f;
                border-bottom: 1px solid #1f1f1f;
                padding: 7px 0 7px 0;
            }

            .total-hdr {
                page-break-inside: avoid;
                page-break-after: avoid;
            }
            .total-label {
                text-align: center;
            }
            .total-amt {
                text-align: right;
            }
            .price-in-words,
            .text-after-total {
                page-break-inside: avoid;
                margin-top: 8px;
                font-size: 8.3pt;
                line-height: 1.5;
            }
            .price-in-words {
                padding-top: 7px;
            }
            .text-after-total p,
            .text-after-total div {
                margin: 0 0 4px 0;
            }
            .opt-head {
                font-weight: bold;
                font-style: italic;
                margin-top: 6px;
                margin-bottom: 4px;
                font-size: 8.3pt;
                color: #4f4f4f;
            }
            .opt-item {
                font-size: 8.3pt;
                font-style: italic;
                color: #5a5a5a;
                line-height: 1.55;
                margin-left: 0;
                font-weight: normal;
            }

            /* Page break */
            .pgbreak { page-break-before: always; }

            /* CONDITIONS / PROVISIONS */
            .section-heading {
                font-size: 12pt;
                font-weight: bold;
                color: #1a3a6b;
                border-bottom: 1.5px solid #1a3a6b;
                padding-bottom: 4px;
                margin-bottom: 12px;
            }
            .conditions-heading {
                font-size: 11pt;
                font-weight: bold;
                color: #000000;
                border: 0;
                padding-bottom: 0;
                margin-bottom: 2px;
                line-height: 1.15;
            }
            .conditions-heading p,
            .conditions-heading div {
                margin: 0;
                padding: 0;
            }
            .provisions-heading {
                font-size: 9pt;
                font-weight: bold;
                color: #000000;
                text-align: center;
                border: 0;
                padding: 0;
                margin: 28px 0 12px 0;
                line-height: 1.15;
            }
            .provisions-heading p,
            .provisions-heading div {
                margin: 0;
                padding: 0;
            }
            .clause-title {
                font-weight: bold;
                font-size: 8.5pt;
                margin-top: 10px;
                margin-bottom: 3px;
            }
            .clause-body {
                font-size: 8.2pt;
                line-height: 1.55;
                text-align: justify;
                margin-bottom: 3px;
            }
            .bullet {
                font-size: 8.2pt;
                line-height: 1.5;
                margin-left: 14px;
                margin-bottom: 2px;
            }
            .preamble {
                font-size: 8.2pt;
                line-height: 1.55;
                text-align: justify;
                margin-bottom: 12px;
            }
            .sig-block {
                margin-top: 32px;
                font-size: 8.5pt;
                line-height: 1.85;
            }
    </style>
    </head>
    <body>

        <div id="header" style="width: 674.5px;">
            <div id="header-inner">
                <apex:outputPanel rendered="{!IF(showSaveQuote == true, true, false)}"> 
                    <apex:image value="{!quoteTemplate.Header_Image__c}" styleClass="header-banner"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!IF(showSaveQuote == false, true, false)}">
                    <apex:image value="{!quoteTemplate.Draft_Image__c}" style="width:200px;height:90px;position: relative;"/>
                </apex:outputPanel>
            </div>
            <br/>
            <div style="font-size:15px; line-height:1;">
                <span style="color:#000000;">Quotation No:</span>
                <span style="color:#656565;">&#160;&#160;&#160;{!ObjQuote.Quote_Number__c}</span><br/>

                <span style="color:#000000;">Date:</span>
                <span style="color:#656565;">&#160;&#160;&#160;{!IF(NOT(ISBLANK(TodayDate_string)), TodayDate_string, TEXT(ObjQuote.DATE__c))}</span>
            </div>
        </div>

        <div id="footer">
            <div class="footer-topline"></div>
            <table class="footer-grid">    
                <tr>
                    <td style="width: 100px; padding-right: 57px;">
                        Nissei ASB GmbH<br/>
                        Wahlerstr. 8<br/>
                        40472 D&#252;sseldorf<br/>
                        Germany
                    </td>
                    <td style="width: 100px; padding-right: 57px;">
                        Gesch&#228;ftsf&#252;hrung:<br/>
                        Karel Keersmaekers-Michiels<br/>
                        Kota Aoki<br/>
                        Eva Alzas Guillen
                    </td>
                    <td style="width: 100px; padding-right: 57px;">
                        Sitz der Gesellschaft:<br/>
                        Amtsgericht D&#252;sseldorf<br/>
                        HRB 22191
                    </td>
                    <td style="width: 100px;">
                        St.-Nr.: 105/5832/0456<br/>
                        VAT-No.: DE119353439<br/>
                        Tel.:+49 (211) 941040<br/>
                        www.nisseiasb.co.jp
                    </td>
                </tr>
            </table>
            <div class="footer-page">
                Page <span class="pagenumber"></span> of <span class="pagecount"></span>
            </div>
        </div>

        <!-- CONTENT -->

        <!-- LINE ITEMS -->
        <table class="recipient-table">
            <tr>
                <td class="recipient-left">
                    <apex:outputPanel rendered="{!NOT(ISBLANK(ObjQuote.QUOTATION_ADDRESSED_TO__c))}">
                        <div>{!ObjQuote.QUOTATION_ADDRESSED_TO__r.Name}</div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!AND(ISBLANK(ObjQuote.QUOTATION_ADDRESSED_TO__c), NOT(ISBLANK(ObjQuote.QuoteToName)))}">
                        <div>{!ObjQuote.QuoteToName}</div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!AND(ISBLANK(ObjQuote.QUOTATION_ADDRESSED_TO__c), ISBLANK(ObjQuote.QuoteToName), NOT(ISBLANK(ObjAccount.Legal_Name__c)))}">
                        <div>{!ObjAccount.Legal_Name__c}</div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!NOT(ISBLANK(address))}">
                        <div><apex:outputText escape="false" value="{!address}"/></div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!AND(ISBLANK(address), NOT(ISBLANK(ObjQuote.QuoteToStreet)))}">
                        <div>{!ObjQuote.QuoteToStreet}</div>
                        <div>{!ObjQuote.QuoteToCity}<apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(ObjQuote.QuoteToPostalCode))}">, {!ObjQuote.QuoteToPostalCode}</apex:outputPanel></div>
                        <div>{!ObjQuote.QuoteToCountry}</div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!AND(ISBLANK(address), ISBLANK(ObjQuote.QuoteToStreet))}">
                        <div>(HC) Recipient address not mapped</div>
                    </apex:outputPanel>
                </td>
            </tr>
        </table>

        <apex:outputPanel rendered="{!NOT(ISBLANK(terms))}">
            <table class="terms-table">
                <tbody>
                    <apex:repeat value="{!terms}" var="qTerms">
                        <tr>
                            <td class="terms-value"><apex:outputField value="{!qTerms.Content_2__c}"/></td>
                        </tr>
                    </apex:repeat>
                </tbody>
            </table>
        </apex:outputPanel>

        <table class="items-table">
            <thead>
                <tr>
                    <th style="width:5%;">Pos.</th>
                    <th style="width:54%;">Description</th>
                    <th class="c" style="width:10%;">Quantity</th>
                    <th class="r" style="width:16%;">Unit Price {!ObjQuote.CurrencyIsoCode}</th>
                    <th class="r" style="width:15%;">Total {!ObjQuote.CurrencyIsoCode}</th>
                </tr>
            </thead>
            <tbody>
                <apex:repeat value="{!prodLineList}" var="qLine">
                    <apex:outputPanel layout="none" rendered="{!NOT(qLine.Is_Tax)}">
                        <tr class="section-hdr">
                            <td colspan="5">
                                <apex:outputText value="{!IF(NOT(ISBLANK(qLine.Product_Type)), qLine.Product_Type, '')}"/>
                            </td>
                        </tr>
                        <tr class="main-item-row">
                            <td>{!qLine.Position_Number}</td>
                            <td>
                                <apex:outputPanel rendered="{!ISBLANK(qLine.Product_Description)}">
                                    <strong>{!qLine.Product_Name}</strong>
                                </apex:outputPanel>
                                <apex:outputText rendered="{!NOT(ISBLANK(qLine.Product_Description))}" escape="false" value="{!qLine.Product_Description}"/>
                                <apex:outputPanel rendered="{!NOT(ISBLANK(qLine.Option_Header))}">
                                    <div class="opt-head">{!qLine.Option_Header}</div>
                                </apex:outputPanel>
                            </td>
                            <td class="c">{!qLine.Quantity}</td>
                            <td class="r">{!qLine.totalValueString}</td>
                            <td class="r">{!qLine.Ceiling_Total_Sales_Pricestring}</td>
                        </tr>
                        <apex:repeat value="{!qLine.childProd}" var="qOpt">
                            <apex:outputPanel layout="none" rendered="{!NOT(qOpt.Name_Hide)}">
                                <tr class="{!IF(qOpt.Pdf_Checked, 'priced-opt-row', 'option-row')}">
                                    <td></td>
                                    <td>
                                        <div class="opt-item">
                                            <apex:outputPanel rendered="{!NOT(ISBLANK(qOpt.Description))}">
                                                <apex:outputText escape="false" value="{!qOpt.Description}"/>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!ISBLANK(qOpt.Description)}">
                                                {!qOpt.Manual_Product_Name}
                                            </apex:outputPanel>
                                        </div>
                                    </td>
                                    <td class="c">
                                        <apex:outputPanel rendered="{!qOpt.Pdf_Checked}">
                                            {!IF(qOpt.Quantity != null, qOpt.Quantity, '')}
                                        </apex:outputPanel>
                                    </td>
                                    <td class="r">
                                        <apex:outputPanel rendered="{!qOpt.Pdf_Checked}">
                                            {!IF(qOpt.Manual_Option_List_Price != null, qOpt.Manual_Option_List_Price, '')}
                                        </apex:outputPanel>
                                    </td>
                                    <td class="r">
                                        <apex:outputPanel rendered="{!qOpt.Pdf_Checked}">
                                            {!IF(qOpt.Sales_Price != null, qOpt.Sales_Price, '')}
                                        </apex:outputPanel>
                                    </td>
                                </tr>
                            </apex:outputPanel>
                        </apex:repeat>
                    </apex:outputPanel>
                </apex:repeat>
            </tbody>
        </table>
        <table class="items-total-table">
            <tbody>
                <tr class="total-hdr">
                    <td colspan="4" class="total-label">
                        <apex:outputText value="{!ObjQuote.Q_PrintShipping__c}" escape="false"/>
                    </td>
                    <td class="total-amt">{!getWithoutTaxGrandValueString}</td>
                </tr>
            </tbody>
        </table>
        <apex:outputPanel rendered="{!ObjQuote.Price_in_Word_Required__c}">
            <div class="price-in-words">
                <apex:outputText value="{!IF(NOT(ISBLANK(quoteTemplate.Label_for_Price_in_Word__c)), quoteTemplate.Label_for_Price_in_Word__c, 'Price In Words:')}"/>
                <apex:outputText value=" {!no2words}"/>
            </div>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!NOT(ISBLANK(ObjQuote.Text_After_Total__c))}">
            <div class="text-after-total">
                <apex:outputText value="{!ObjQuote.Text_After_Total__c}" escape="false"/>
            </div>
        </apex:outputPanel>


        <!-- GENERAL CONDITIONS -->
        <apex:outputPanel rendered="{!NOT(ISBLANK(quoteTemplate.Id))}">
            <apex:outputPanel rendered="{!quoteTemplate.Section_4_Required__c}">
                <div class="pgbreak">
                <div class="conditions-heading">
                    <apex:outputPanel rendered="{!NOT(ISBLANK(quoteTemplate.S4_Title__c))}">
                        <apex:outputText value="{!quoteTemplate.S4_Title__c}" escape="false"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!ISBLANK(quoteTemplate.S4_Title__c)}">
                        <u>GENERAL CONDITIONS</u>
                    </apex:outputPanel>
                </div>
                <apex:repeat value="{!gRemark}" var="remark">
                    <div class="clause-body">
                        <apex:outputField value="{!remark.Content_2__c}"/>
                    </div>
                </apex:repeat>
                </div>
            </apex:outputPanel>

            <!-- GENERAL PROVISIONS -->
            <apex:outputPanel rendered="{!quoteTemplate.Section_5_Required__c}">
                <div class="pgbreak">
                <div class="provisions-heading">
                    <apex:outputPanel rendered="{!NOT(ISBLANK(quoteTemplate.S5_Title__c))}">
                        <apex:outputText value="{!quoteTemplate.S5_Title__c}" escape="false"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!ISBLANK(quoteTemplate.S5_Title__c)}">
                        GENERAL PROVISIONS
                    </apex:outputPanel>
                </div>
                <apex:repeat value="{!gProvision}" var="provision">
                    <div class="clause-body">
                        <apex:outputField value="{!provision.Content_2__c}"/>
                    </div>
                </apex:repeat>
                </div>
            </apex:outputPanel>
        </apex:outputPanel>
    </body>
    </html>
</apex:page>